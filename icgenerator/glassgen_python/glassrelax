#!/bin/bash
# Wrapper used for relaxing a distribution of particles to a glass following an arbitrary density profile.
# glassrelax has two input modes, a pre-IC can be given to it and relaxed given a certain density profile (glassrelax tipsyfile )
# or a random distribution of N particles  is sampled from the density table given, and is relaxed toward a certain density profile (--table X.npz --count N).
# The density profile is given by a table (1D,2D or 3D), where it's extent and coordinate system is 
# given in the table header. The density profile can also be given by an analytical function (see which profiles in density_from_param), which requires a pre-IC and .param file 
# The box size and periodicity is given by the *.param file if present otherwise it can be specified by --box LX LY LZ or by --open if it is an open boundary.
# The --open option generates a free-surface build: internal padded frame + vacuum scaffold + temporary background particles, culled after the relax.
# If no input.param (with the relevant IC profile keys) or table is given, then it will default to uniform density.
# Currently only gas will be relaxed (dark and star particles pass through to the output unchanged.)

# The default input param and output if not given is:
# Mode 1, ./glassrelax input
# --param <input minus .NNNNN>.param 
# -o      <input minus .NNNNN>_glass 

# For Mode 2, ./glassrelax --count N --table x.npz -o myoutput needs to be given.

# nsmooth default -s 64

# If you want to diagnose/see output of relaxation then use 
# -oi for output snapshot interval, 
# --plot for final density-error/residual-force figure and
# --history-plot for a final time plot of the step size, density error and force error (most useful).

# The remaining input flags can be seen with --help (and expert flags given by --help-extra)
# They mainly include flags related to quality, stopping criterion, envelope(open build), cascade(multi-grid relaxaation) and general relaxation parameters.


set -euo pipefail

pkgroot=$(cd "$(dirname "$0")" && pwd)

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
    echo "usage: $(basename "$0") <pre-IC tipsy file> [options]"
    echo
    PYTHONPATH=$pkgroot python -m glassgen.cli --help
    exit 0
fi

if [[ $1 == -* ]]; then
    # this is to distinguish between the two input modes discussed above, 
    # If IC file it is given directly like glassrelax input , if it instead starts 
    # with flag - then we assume it is a --count table relax
    exec env PYTHONPATH=$pkgroot${PYTHONPATH:+:$PYTHONPATH} \
        python -m glassgen.cli "$@"
fi

infile=$1; shift
[[ -f $infile ]] || { echo "glassrelax: no such file: $infile" >&2; exit 1; }

base=$infile
[[ $infile =~ ^(.*)\.[0-9]+$ ]] && base=${BASH_REMATCH[1]}

args=("$@")
have_out=0 have_box=0
for a in "${args[@]}"; do
    case $a in
        -o) have_out=1 ;;
        --param|--param=*|--box|--open) have_box=1 ;;
    esac
done
((have_out)) || args+=(-o "${base}_glass")
if ((!have_box)); then
    if [[ -f $base.param ]]; then
        args+=(--param "$base.param")
    else
        echo "glassrelax: no $base.param found - pass --param, --box LX LY LZ, or --open" >&2
        exit 1
    fi
fi

exec env PYTHONPATH=$pkgroot${PYTHONPATH:+:$PYTHONPATH} \
    python -m glassgen.cli -I "$infile" "${args[@]}"
