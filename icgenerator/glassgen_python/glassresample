#!/bin/bash
# glassresample: resample a tipsy snapshot (particle fields + all aux
# files) with the Python icgenerator. Ops: --op split | merge | reconstruct.
# split/merge act on any particle types (default ALL present; --particletype
# restricts it, the rest pass through unchanged). reconstruct rebuilds the
# GAS at an arbitrary --count N against its captured density table (the
# glassgen table builder); dark/star pass through.
#
# usage: glassresample <tipsy.NNNNN> [resample_cli options...]
#
#   glassresample ic.00000 --op split --ntimes 3
#   glassresample fine.00000 --particletype gas dark --op merge -o coarse
#   glassresample ic.00000 --op reconstruct --count 2000000 -o ic_2M
#
# Defaults derived from the input name (overridden by passing the flag
# yourself):
#   --param <input minus .NNNNN>.param   (when that file exists)
# Split/merge output defaults to
# <input minus .NNNNN>_<op>_<factor>x.00000 (factor=2**ntimes);
# reconstruct uses _recon.00000.
# The operation is asked for interactively when --op is omitted.
# Everything else (--particletype, --op, --ntimes, -s, --dist, ...)
# is passed straight to glassgen.resample_cli; run with --help to list.
set -euo pipefail

pkgroot=$(cd "$(dirname "$0")" && pwd)

if [[ $# -lt 1 || $1 == -h || $1 == --help ]]; then
    echo "usage: $(basename "$0") <tipsy file> [options]"
    echo
    PYTHONPATH=$pkgroot python -m glassgen.resample_cli --help
    exit 0
fi

infile=$1; shift
[[ -f $infile ]] || { echo "glassresample: no such file: $infile" >&2; exit 1; }

base=$infile
[[ $infile =~ ^(.*)\.[0-9]+$ ]] && base=${BASH_REMATCH[1]}

args=("$@")
have_box=0
# Iterate over the positional parameters directly: on macOS's Bash 3.2,
# expanding an empty array under `set -u` raises "args[@]: unbound variable".
for a in "$@"; do
    case $a in
        --param|--param=*|--box|--open) have_box=1 ;;
    esac
done
if ((!have_box)); then
    if [[ -f $base.param ]]; then
        args+=(--param "$base.param")
    else
        echo "glassresample: no $base.param found - pass --param, --box LX LY LZ, or --open" >&2
        exit 1
    fi
fi

exec env PYTHONPATH=$pkgroot${PYTHONPATH:+:$PYTHONPATH} \
    python -m glassgen.resample_cli -I "$infile" "${args[@]}"
